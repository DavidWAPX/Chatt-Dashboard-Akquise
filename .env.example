# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key. Server-side only: read exclusively in lib/supabase/admin.ts
# and used only by route handlers under app/api/admin/**. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Optional — nur setzen, wenn andere Quellen als die eingebauten gelten sollen.
# Beide müssen auf "Jeder mit dem Link – Betrachter" stehen.
# LEADS_SHEET_CSV_URL=https://docs.google.com/spreadsheets/d/<id>/export?format=csv
# SKRIPT_DOC_HTML_URL=https://docs.google.com/document/d/<id>/export?format=html
